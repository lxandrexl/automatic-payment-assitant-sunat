# --- apps/worker ---
MONGODB_URI=mongodb+srv://user:pass@cluster.xxxx.mongodb.net/tributo

# Telegram (canal principal). BotFather → token; chat_id vía getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail app password (2FA requerido). Sirve para SMTP (respaldo) e IMAP (buzón SUNAT).
SMTP_USER=tucorreo@gmail.com
SMTP_APP_PASSWORD=
# Destino del email de respaldo (default: SMTP_USER).
NOTIFY_EMAIL=

TZ=America/Lima
LOG_LEVEL=info
