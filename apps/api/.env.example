# --- apps/api ---
# Atlas M0 (proyecto propio de Tributo). Allowlist: IP pública reservada de la VM.
MONGODB_URI=mongodb+srv://user:pass@cluster.xxxx.mongodb.net/tributo

# Clave del header X-Api-Key en rutas mutantes. MISMO valor en api y web (server-side).
# Generar con: openssl rand -hex 24
API_KEY=

# Puerto interno (lo publica el túnel, no la caja).
PORT=3001

# Contribuyente (single-user).
RUC=10727357730
RUC_LAST_DIGIT=0

TZ=America/Lima
