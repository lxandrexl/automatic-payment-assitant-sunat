# === Tributo — .env único del stack (docker-compose lo lee vía env_file) ===
# Copiar a .env en la VM, chmod 600. NUNCA commitear el .env real.

# --- Base de datos ---
# Atlas M0 (proyecto propio de Tributo). Allowlist: IP pública reservada de la VM.
MONGODB_URI=mongodb+srv://user:pass@cluster.xxxx.mongodb.net/tributo

# --- API ---
# Clave del header X-Api-Key en rutas mutantes. Generar: openssl rand -hex 24
API_KEY=
RUC=10727357730
RUC_LAST_DIGIT=0

# --- Telegram (canal principal) ---
# BotFather → token; chat_id vía https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Gmail app password (2FA requerido): SMTP (respaldo) + IMAP (buzón SUNAT) ---
SMTP_USER=tucorreo@gmail.com
SMTP_APP_PASSWORD=
NOTIFY_EMAIL=

# --- Cloudflare Tunnel (propio de Tributo, no el de la liga) ---
CLOUDFLARE_TUNNEL_TOKEN=

TZ=America/Lima
